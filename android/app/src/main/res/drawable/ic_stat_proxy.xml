<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: the "T" of the app. Drawn as two round-capped strokes so it
  stays legible at the ~18 dp the status bar gives a notification icon, and
  monochrome white because that is all the system renders for a small icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5.6,6.4 H18.4 M12,6.4 V18.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
</vector>
